{
  "name": "statskill-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Competency-based workforce upskilling platform for the Indian official statistical system (SIH prototype)",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "dev:mongo": "node server/scripts/dev-mongo.mjs",
    "seed": "npm run seed --workspace server",
    "build": "npm run build --workspace client",
    "start": "npm run dev",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "9.1.2"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
