# ---------------------------------------------------------------------------
# StatSkill AI backend — environment template
# Copy to .env and fill in. NEVER commit the real .env.
# The platform runs FULLY with zero API keys (mock AI + local embeddings).
# ---------------------------------------------------------------------------

# Runtime: development | test | production
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# ---- Database -------------------------------------------------------------
# Production MongoDB URI. In development/test, if this is empty the server
# boots an embedded dev database automatically (in-memory mongod, or the
# bundled EasyDB SQLite fallback when the binary cannot be downloaded).
MONGODB_URI=

# ---- Auth / JWT -----------------------------------------------------------
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# ---- CORS -----------------------------------------------------------------
# Comma-separated list of allowed browser origins ('*' allowed in dev).
CLIENT_ORIGIN=http://localhost:5173

# ---- AI providers (all optional — mock is used when unset) ----------------
# LLM: gemini | openai | mock (default mock)
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set to false in production to hard-disable the deterministic mock LLM.
INCLUDE_MOCK_PROVIDER=true

# Embeddings: local (default, zero-dependency hashed n-gram vectors) | gemini | openai
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=256

# ---- Hybrid recommendation weights (prompt §11 — must sum ~1.0) -----------
REC_WEIGHT_GAP=0.35
REC_WEIGHT_ROLE=0.20
REC_WEIGHT_SEMANTIC=0.20
REC_WEIGHT_DIFFICULTY=0.10
REC_WEIGHT_HISTORY=0.05
REC_WEIGHT_POPULARITY=0.05
REC_WEIGHT_FRESHNESS=0.05

# Skill-gap priority thresholds (prompt §6)
GAP_CRITICAL_THRESHOLD=40
GAP_HIGH_THRESHOLD=25
GAP_MEDIUM_THRESHOLD=10

# ---- Official course providers (prompt §40) -------------------------------
# A provider activates ONLY when both URL and key are configured. No scraping.
# IGOT (iGOT Karmayogi)
IGOT_BASE_URL=
IGOT_API_KEY=
# NSSTA
NSSTA_BASE_URL=
NSSTA_API_KEY=
# MoSPI
MOSPI_BASE_URL=
MOSPI_API_KEY=
# Provider sync interval in minutes (0 disables the cron sync)
SYNC_INTERVAL_MINUTES=0

# ---- Optional infrastructure ---------------------------------------------
# Firebase (realtime communities + push). Leave empty to use in-DB fallback.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Firebase service-account JSON can be supplied as a file path instead.
FIREBASE_CREDENTIALS_FILE=

# Redis + BullMQ (background jobs). Leave empty to use in-process fallback.
REDIS_URL=
JOB_CONCURRENCY=2

# ---- Uploads --------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# ---- Rate limiting --------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ---- Public landing page ---------------------------------------------------
# How long GET /api/stats/public reuses one computed payload (seconds).
# Protects Mongo from landing-page traffic spikes. 0 disables caching.
PUBLIC_STATS_CACHE_TTL_SEC=15
