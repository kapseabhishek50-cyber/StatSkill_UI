# ---- Copy to .env and fill in. Never commit .env. ----

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB (local default; swap for an Atlas SRV string in deployment)
MONGODB_URI=mongodb://127.0.0.1:27017/statskill

# Auth. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=12h

# ---- LLM ----
# Leave ANTHROPIC_API_KEY unset to run the deterministic mock provider.
# The whole app works without a key; only the wording of generated content changes.

# Get a free Gemini API key from https://aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY=AQ.Ab8RN6J0_Wiw3jTtN97uPJnz1xRAAhMppL7m87uGvvC7H6sdBg
GOOGLE_GEMINI_MODEL=gemini-3.6-flash

# low | medium | high | xhigh | max  (higher = better reasoning, more tokens)
LLM_EFFORT=low
# Pre-generated demo content is served from cache instead of calling the API live.
# Keep true for demos and judging: no stage latency, no bad-generation risk.
LLM_CACHE_ENABLED=true

# ---- External API Configuration (project owner provides real values) ----
# iGOT Karmayogi (Government training portal)
IGOT_API_URL=https://api.igot.gov.in
IGOT_API_KEY=replace-me-with-igot-api-key

# NSSTA (National Statistical Systems Training Academy)
NSSTA_API_URL=https://api.nssta.gov.in
NSSTA_API_KEY=replace-me-with-nssta-api-key

# Generic Training Provider
TRAINING_API_URL=https://training.example.com/api/v1
TRAINING_API_KEY=replace-me-with-training-api-key

# Official Statistics Datasets
STATISTICS_API_URL=https://statistics.example.gov/api/v1
STATISTICS_API_KEY=replace-me-with-statistics-api-key

# External Learning Platforms
EXTERNAL_LEARNING_API_URL=https://learning.example.com/api/v1
EXTERNAL_LEARNING_API_KEY=replace-me-with-external-learning-api-key

# ---- Firebase Realtime Database (for live chat) ----
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Uploads
MAX_UPLOAD_MB=10